# request() appends /api/{resource} to this base URL.
VITE_API_URL=
# To use a local Supabase stack instead of production:
# VITE_API_PROXY_TARGET=http://127.0.0.1:54321/functions/v1
# Optional asset override. Production defaults to the public Supabase app-assets/v1 path.
# VITE_ASSET_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/app-assets/v1
# Public values used only for the Realtime invalidation channel.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
